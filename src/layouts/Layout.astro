---
import { langOf, localize, altPath } from '../lib/i18n';
import interRegular from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import grotesk700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import '@fontsource/inter/latin-300.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/space-grotesk/latin-400.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-600.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/fira-code/latin-400.css';
import '@fontsource/fira-code/latin-500.css';

interface Props {
	title?: string;
	description?: string;
	titleDe?: string;
	descriptionDe?: string;
	noindex?: boolean;
}

const lang = langOf(Astro.url.pathname);
const {
	title: titleEn = "postctl — Social Media Management from your Terminal",
	description: descEn = "Terminal-native, Markdown-first social media scheduler. Publish to Instagram, Facebook, Threads, X, LinkedIn, Bluesky and Mastodon from CLI or TUI. Local, no cloud.",
	titleDe = "postctl — Social-Media-Management im Terminal",
	descriptionDe = "Terminal-nativer, Markdown-basierter Social-Media-Scheduler. Veröffentliche auf Instagram, Facebook, Threads, X, LinkedIn, Bluesky und Mastodon per CLI oder TUI. Lokal, ohne Cloud.",
	noindex = false,
} = Astro.props;
const title = lang === 'de' ? titleDe : titleEn;
const description = lang === 'de' ? descriptionDe : descEn;

const site = Astro.site || Astro.url.origin;
const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonicalURL = new URL(path, site).href;
const alt = altPath(path);
const enURL = new URL(lang === 'en' ? path : alt, site).href;
const deURL = new URL(lang === 'de' ? path : alt, site).href;
const ogImageURL = new URL('/og-image.png', site).href;

// One language per document: the page body is rendered, then cut to the active language.
const body = localize(await Astro.slots.render('default'), lang, path);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preload" as="font" type="font/woff2" href={interRegular} crossorigin />
		<link rel="preload" as="font" type="font/woff2" href={grotesk700} crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="apple-touch-icon" href="/appicon_512.jpg" />
		<meta name="theme-color" content="#08090b" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- SEO Best Practices -->
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
		<link rel="alternate" hreflang="en" href={enURL} />
		<link rel="alternate" hreflang="de" href={deURL} />
		<link rel="alternate" hreflang="x-default" href={enURL} />
		
		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:site_name" content="postctl" />
		<meta property="og:locale" content={lang === "de" ? "de_DE" : "en_US"} />
		<meta property="og:locale:alternate" content={lang === "de" ? "en_US" : "de_DE"} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="postctl terminal UI: dashboard with campaigns, next posts and platform status" />

		<!-- Twitter -->
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={canonicalURL} />
		<meta property="twitter:title" content={title} />
		<meta property="twitter:description" content={description} />
		<meta property="twitter:image" content={ogImageURL} />
		
		<!-- JSON-LD Structured Data for Search Engines -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SoftwareApplication",
			"name": "postctl",
			"operatingSystem": "macOS, Linux",
			"applicationCategory": "DeveloperApplication",
			"offers": {
				"@type": "Offer",
				"price": "0",
				"priceCurrency": "USD"
			},
			"inLanguage": lang,
			"description": lang === "de" ? "Terminal-nativer, Markdown-basierter Social-Media-Scheduler für Instagram, Facebook, Threads, X, LinkedIn, Bluesky und Mastodon — CLI und TUI, lokale Daten, Scheduler-Dienst, mehrere Profile." : "A terminal-native, Markdown-first social media scheduler and publisher for Instagram, Facebook, Threads, X, LinkedIn, Bluesky and Mastodon — CLI and TUI, local data, scheduler service, multiple profiles.",
			"url": "https://postctl.sh",
			"image": "https://postctl.sh/og-image.png",
			"featureList": ["Instagram feed, carousel and story posts", "Facebook page and Threads posts with alt text", "Multiple profiles with one scheduler service each", "Markdown frontmatter import", "Built-in safeguards against account bans", "Remote deletion", "MCP server for AI assistants"],
			"developer": {
				"@type": "Person",
				"name": "aeon022"
			}
		})} />

	</head>
	<body>
		<Fragment set:html={body} />
	</body>
</html>

<style is:global>

/* Full JetBrains Mono (OFL) for the TUI mockups: the npm subsets lack box-drawing/block glyphs, so the borders
   fell back to a system font and broke (gaps between rows). */
@font-face { font-family: 'JB Mock'; font-style: normal; font-weight: 400; font-display: swap; src: url(/fonts/JetBrainsMono-Regular.woff2) format('woff2'); }
@font-face { font-family: 'JB Mock'; font-style: normal; font-weight: 700; font-display: swap; src: url(/fonts/JetBrainsMono-Bold.woff2) format('woff2'); }
	/* Cross-page transitions (Chrome/Edge/Safari 18+): fade + slight rise between home and docs */
	@view-transition { navigation: auto; }
	::view-transition-old(root) { animation: vt-out .22s ease both; }
	::view-transition-new(root) { animation: vt-in .38s cubic-bezier(.16,1,.3,1) both; }
	@keyframes vt-out { to { opacity: 0; transform: translateY(-6px); } }
	@keyframes vt-in { from { opacity: 0; transform: translateY(10px); } }
	@media (prefers-reduced-motion: reduce) { ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*) { animation: none !important; } }

	:root {
		--bg-primary: #08090b;
		--bg-secondary: #111318;
		--bg-tertiary: #1b1e26;
		
		--text-primary: #f3f4f6;
		--text-secondary: #9ca3af;
		--text-muted: #6b7280;
		
		--accent: #8b7cf8;
		--accent-glow: rgba(139, 124, 248, 0.15);
		--accent-hover: #a195f9;
		
		--success: #10b981;
		--error: #ef4444;
		--border: rgba(255, 255, 255, 0.08);
		--border-hover: rgba(255, 255, 255, 0.15);
		
		--font-heading: 'Space Grotesk', sans-serif;
		--font-body: 'Inter', sans-serif;
		--font-mono: 'Fira Code', monospace;
		
		--transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
		--shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.5);
		--shadow-md: 0 8px 30px rgba(0, 0, 0, 0.7);
		--shadow-lg: 0 12px 50px rgba(0, 0, 0, 0.9);
	}

	* {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	/* EN/DE language toggle (see components/LangToggle.astro for the JS half).
	   Must live here, not in LangToggle.astro: Astro drops <style is:global>
	   from components that render no DOM output, so it silently never made
	   it into the built CSS and both languages showed at once everywhere. */
	html[lang="de"] .lang-en { display: none !important; }
	html[lang="en"] .lang-de { display: none !important; }

	html {
		scroll-behavior: smooth;
		background-color: var(--bg-primary);
		color: var(--text-primary);
		font-family: var(--font-body);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	body {
		min-height: 100vh;
		overflow-x: hidden;
		background: radial-gradient(circle at 50% 0%, var(--bg-secondary) 0%, var(--bg-primary) 70%);
	}

	a {
		color: inherit;
		text-decoration: none;
		transition: var(--transition);
	}

	h1, h2, h3, h4, h5, h6 {
		font-family: var(--font-heading);
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	code, pre {
		font-family: var(--font-mono);
	}

	/* Scrollbar Styling */
	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
	}
	::-webkit-scrollbar-track {
		background: var(--bg-primary);
	}
	::-webkit-scrollbar-thumb {
		background: var(--bg-tertiary);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: var(--accent);
	}

	/* Utility Classes */
	.container {
		width: 100%;
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.text-gradient {
		background: linear-gradient(135deg, #fff 0%, var(--accent) 100%);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}
.screenshot-section {
  padding: 4rem 0;
  background: rgba(255,255,255,0.04);
  backdrop-filter: blur(12px);
  border-radius: 16px;
  margin: 3rem auto;
}

.screenshot-section .container {
  max-width: 1000px;
}

.screenshot-carousel {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  padding-bottom: 0.5rem;
  scrollbar-width: thin;
}

.screenshot-carousel::-webkit-scrollbar {
  height: 4px;
}

.screenshot-carousel::-webkit-scrollbar-thumb {
  background: var(--accent);
  border-radius: 2px;
}

.screenshot {
  flex: 0 0 auto;
  width: 400px;
  height: auto;
  max-height: 260px;
  object-fit: contain;
  border-radius: 12px;
  box-shadow: var(--shadow-sm);
  scroll-snap-align: start;
  transition: transform 0.3s ease;
  border: 2px solid rgba(255,255,255,0.08);
  cursor: pointer;
}

.screenshot-item {
  text-align: center;
}

.screenshot-item figcaption {
  margin-top: 0.5rem;
  color: var(--text-secondary);
  font-size: 0.9rem;
}

@media (max-width: 768px) {
  .screenshot {
    width: 80vw;
    height: auto;
  }
}
</style>


