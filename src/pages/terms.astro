---
import Layout from '../layouts/Layout.astro';
import FooterSignature from '../components/FooterSignature.astro';
---

<Layout title="Terms of Use & Pro License — postctl" titleDe="Nutzungsbedingungen & Pro-Lizenz — postctl" description="Terms of use for postctl: free MIT core, Pro license (5 devices, lifetime updates while developed), 30-day money-back guarantee." descriptionDe="Nutzungsbedingungen für postctl: kostenloser MIT-Kern, Pro-Lizenz (5 Geräte, Lifetime-Updates solange entwickelt), 30 Tage Geld-zurück-Garantie.">
  <!-- Background Glows -->
  <div class="bg-glow bg-glow-1"></div>
  <div class="bg-glow bg-glow-2"></div>
  <div class="grid-overlay"></div>

  <!-- Minimal Header -->
  <header class="tui-page-header">
    <a href="/" class="tui-logo">
      <span class="logo-icon">&gt;_</span>
      <span class="logo-text">postctl<span class="logo-blink">_</span></span>
    </a>
    <div class="tui-page-header-right">
      <a href="/" class="back-link"><span class="lang-en">← Back to Home</span><span class="lang-de">← Zurück zur Startseite</span></a>
      <a id="lang-toggle" href="__ALT_LANG_URL__" class="lang-toggle-btn" aria-label="Switch language" style="text-decoration:none;display:inline-flex;align-items:center;">
        <span class="lang-en">DE</span>
        <span class="lang-de">EN</span>
      </a>
    </div>
  </header>

  <main class="tui-page-main">
    <!-- Section Header -->
    <div class="tui-page-section-header">
      <div class="section-tag"><span class="lang-en">Legal</span><span class="lang-de">Rechtliches</span></div>
      <h1 class="section-title"><span class="lang-en">Terms of Use & Pro License</span><span class="lang-de">Nutzungsbedingungen & Pro-Lizenz</span></h1>
      <p class="section-subtitle">
        <span class="lang-en">What you get, what Lifetime means, refunds and responsibilities.</span>
        <span class="lang-de">Was du bekommst, was Lifetime bedeutet, Rückerstattung und Verantwortung.</span>
      </p>
      <p class="lang-note">
        <span class="lang-en">Last updated: 17 October 2026. This English version is a courtesy translation. The German version is legally binding.</span>
        <span class="lang-de">Stand: 17. Oktober 2026. Dies ist die maßgebliche deutsche Fassung.</span>
      </p>
    </div>

    <!-- Privacy Stack Layout -->
    <div class="privacy-stack">
      <div class="privacy-card">
        <div class="card-label">// 01_SCOPE</div>
        <h3 class="card-title"><span class="lang-en">Scope & Parties</span><span class="lang-de">Geltungsbereich & Vertragspartner</span></h3>
        <p class="card-text">
          <span class="lang-en">These terms apply to the use of postctl and to the purchase of a postctl Pro license. The software and licence are provided by Gerwin Weiher, sole proprietor trading as Abteilung83, Steyrergasse 88/4, 8010 Graz, Austria (<a href="mailto:post@abteilung83.com" class="accent-link underline">post@abteilung83.com</a>). The purchase itself is processed by Polar.sh (Polar Software Inc.) as Merchant of Record; its checkout terms apply to the payment.</span>
          <span class="lang-de">Diese Bedingungen gelten für die Nutzung von postctl und den Kauf einer postctl-Pro-Lizenz. Software und Lizenz stellt Gerwin Weiher, Einzelunternehmer, Abteilung83, Steyrergasse 88/4, 8010 Graz, Österreich (<a href="mailto:post@abteilung83.com" class="accent-link underline">post@abteilung83.com</a>) bereit. Der Kauf selbst wird von Polar.sh (Polar Software Inc.) als Merchant of Record abgewickelt; für die Zahlung gelten deren Checkout-Bedingungen.</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 02_CORE</div>
        <h3 class="card-title"><span class="lang-en">Free Core (MIT)</span><span class="lang-de">Kostenloser Kern (MIT)</span></h3>
        <p class="card-text">
          <span class="lang-en">The core of postctl is open source under the MIT license (see the LICENSE file in the repository) and may be used free of charge with up to 2 connected social networks.</span>
          <span class="lang-de">Der Kern von postctl ist Open Source unter der MIT-Lizenz (siehe Datei LICENSE im Repository) und kann kostenlos mit bis zu 2 verbundenen sozialen Netzwerken genutzt werden.</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 03_PRO_LICENSE</div>
        <h3 class="card-title"><span class="lang-en">Pro License</span><span class="lang-de">Pro-Lizenz</span></h3>
        <p class="card-text">
          <span class="lang-en">A Pro license is a personal, non-transferable right to remove the 2-network limit and to use the Pro features. It may be activated on up to <strong>5 of your own devices</strong>. You receive a license key from Polar after purchase. Do not share the key publicly; we may revoke keys that are shared or misused.</span>
          <span class="lang-de">Eine Pro-Lizenz ist ein persönliches, nicht übertragbares Recht, die Begrenzung auf 2 Netzwerke aufzuheben und die Pro-Funktionen zu nutzen. Sie kann auf bis zu <strong>5 eigenen Geräten</strong> aktiviert werden. Den Lizenzschlüssel erhältst du nach dem Kauf von Polar. Gib ihn nicht öffentlich weiter; wir können Schlüssel sperren, die weitergegeben oder missbraucht werden.</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 04_LIFETIME</div>
        <h3 class="card-title"><span class="lang-en">What "Lifetime" Means</span><span class="lang-de">Was „Lifetime“ bedeutet</span></h3>
        <p class="card-text">
          <span class="lang-en">"Lifetime" means: you pay once and receive all updates of postctl Pro for as long as postctl is actively developed. If we discontinue development we will announce it publicly; the last version you received then stays licensed and usable without further payment. If the licensing service ever becomes unavailable, we will make reasonable efforts to keep licensed installations working.</span>
          <span class="lang-de">„Lifetime“ bedeutet: Du zahlst einmal und erhältst alle Updates von postctl Pro, solange postctl aktiv weiterentwickelt wird. Stellen wir die Entwicklung ein, kündigen wir das öffentlich an; die zuletzt erhaltene Version bleibt dann ohne weitere Zahlung lizenziert und nutzbar. Sollte der Lizenzdienst einmal nicht mehr verfügbar sein, bemühen wir uns in angemessener Weise, lizenzierte Installationen weiter funktionsfähig zu halten.</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 05_REFUND</div>
        <h3 class="card-title"><span class="lang-en">30-Day Money-Back Guarantee</span><span class="lang-de">30 Tage Geld-zurück-Garantie</span></h3>
        <p class="card-text">
          <span class="lang-en">You can return a Pro license within <strong>30 days of purchase without giving a reason</strong>. Send an e-mail with your purchase confirmation to <a href="mailto:post@abteilung83.com" class="accent-link underline">post@abteilung83.com</a>; the refund goes through Polar to your original payment method and the license is deactivated afterwards. This voluntary guarantee applies in addition to any statutory rights, which remain unaffected (for digital content the statutory right of withdrawal can lapse under the conditions of the Austrian FAGG).</span>
          <span class="lang-de">Du kannst eine Pro-Lizenz innerhalb von <strong>30 Tagen nach dem Kauf ohne Angabe von Gründen</strong> zurückgeben. Schreibe dazu eine E-Mail mit deiner Kaufbestätigung an <a href="mailto:post@abteilung83.com" class="accent-link underline">post@abteilung83.com</a>; die Erstattung erfolgt über Polar auf deine ursprüngliche Zahlungsart, danach wird die Lizenz deaktiviert. Diese freiwillige Garantie gilt zusätzlich zu den gesetzlichen Rechten, die unberührt bleiben (bei digitalen Inhalten kann das gesetzliche Widerrufsrecht unter den Voraussetzungen des österreichischen FAGG erlöschen).</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 06_THIRD_PARTIES</div>
        <h3 class="card-title"><span class="lang-en">Third-Party Platforms & Your Responsibility</span><span class="lang-de">Drittplattformen & deine Verantwortung</span></h3>
        <p class="card-text">
          <span class="lang-en">postctl connects to third-party platforms (Instagram, Facebook, Threads, X, LinkedIn, Bluesky, Mastodon and others) using your own accounts and credentials. You are responsible for complying with those platforms' terms and for the content you publish. Platforms may change or restrict their APIs, accounts or rate limits at any time; we have no influence on that.</span>
          <span class="lang-de">postctl verbindet sich mit Drittplattformen (Instagram, Facebook, Threads, X, LinkedIn, Bluesky, Mastodon u. a.) über deine eigenen Konten und Zugangsdaten. Du bist dafür verantwortlich, die Bedingungen dieser Plattformen einzuhalten und für die Inhalte, die du veröffentlichst. Plattformen können ihre Schnittstellen, Konten oder Limits jederzeit ändern oder einschränken; darauf haben wir keinen Einfluss.</span>
        </p>
        <p class="card-text">
          <span class="lang-en"><strong>X cookie mode:</strong> the optional, unofficial cookie mode is switched off by default, not supported and against X's terms. Using it is entirely at your own risk; we accept no liability for suspended or restricted accounts. The official X API is the supported way.</span>
          <span class="lang-de"><strong>X-Cookie-Modus:</strong> Der optionale, inoffizielle Cookie-Modus ist standardmäßig aus, nicht unterstützt und verstößt gegen die X-Nutzungsbedingungen. Die Nutzung erfolgt ausschließlich auf eigenes Risiko; für gesperrte oder eingeschränkte Konten übernehmen wir keine Haftung. Der unterstützte Weg ist die offizielle X-API.</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 07_LIABILITY</div>
        <h3 class="card-title"><span class="lang-en">Warranty & Liability</span><span class="lang-de">Gewährleistung & Haftung</span></h3>
        <p class="card-text">
          <span class="lang-en">The free core is provided "as is" as described in the MIT license. For Pro, we are liable under the mandatory statutory provisions; beyond that, to the extent legally permitted, we are not liable for missed, delayed, duplicated or faulty posts, loss of data or accounts, or consequences of platform changes. Scheduled posts require your device or the scheduler service to be running. Please back up your data.</span>
          <span class="lang-de">Der kostenlose Kern wird „wie besehen“ gemäß der MIT-Lizenz bereitgestellt. Für Pro haften wir nach den zwingenden gesetzlichen Bestimmungen; darüber hinaus haften wir, soweit gesetzlich zulässig, nicht für ausgebliebene, verspätete, doppelte oder fehlerhafte Posts, Daten- oder Kontoverluste oder Folgen von Plattform-Änderungen. Geplante Posts setzen voraus, dass dein Gerät bzw. der Scheduler-Dienst läuft. Bitte sichere deine Daten.</span>
        </p>
      </div>

      <div class="privacy-card">
        <div class="card-label">// 08_LAW</div>
        <h3 class="card-title"><span class="lang-en">Governing Law</span><span class="lang-de">Anwendbares Recht</span></h3>
        <p class="card-text">
          <span class="lang-en">Austrian law applies, excluding the UN Convention on Contracts for the International Sale of Goods. For consumers, the mandatory consumer protection provisions of their country of residence remain unaffected. For businesses, the place of jurisdiction is Graz.</span>
          <span class="lang-de">Es gilt österreichisches Recht unter Ausschluss des UN-Kaufrechts. Für Verbraucher bleiben die zwingenden Verbraucherschutzvorschriften ihres Wohnsitzstaates unberührt. Für Unternehmer ist Gerichtsstand Graz.</span>
        </p>
      </div>
    </div>
  </main>

  <FooterSignature />
</Layout>

<style>
  .privacy-stack {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    max-width: 800px;
    margin: 0 auto 5rem;
  }

  .privacy-card {
    background: #0d0e12b3;
    border: 1px solid #ffffff14;
    border-radius: 12px;
    padding: 2.5rem;
    box-shadow: 0 12px 40px #00000080;
    transition: all 0.25s;
  }

  .privacy-card:hover {
    border-color: #8b7cf833;
    box-shadow: 0 12px 40px rgba(139, 124, 248, 0.05);
    transform: translateY(-2px);
  }

  .card-label {
    font-family: monospace;
    color: #8b7cf8;
    letter-spacing: 0.12em;
    font-size: 0.72rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
    border-bottom: 1px dashed #ffffff14;
    padding-bottom: 0.5rem;
  }

  .card-title {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .card-text {
    font-size: 0.88rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: 1rem;
  }

  .card-text:last-child {
    margin-bottom: 0;
  }

  .accent-link {
    color: #8b7cf8;
    text-decoration: none;
    transition: color 0.2s;
  }

  .accent-link:hover {
    color: #a99ef8;
  }

  /* Core Layout Styles override/additions */
  .bg-glow {
    background: radial-gradient(circle, rgba(139, 124, 248, 0.08) 0%, rgba(8, 9, 11, 0) 70%);
    z-index: -2;
    pointer-events: none;
    border-radius: 50%;
    width: 600px;
    height: 600px;
    position: absolute;
  }
  .bg-glow-1 {
    top: -150px;
    left: calc(50% - 300px);
  }
  .bg-glow-2 {
    top: 600px;
    right: -200px;
  }
  .grid-overlay {
    background-image: linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    z-index: -1;
    pointer-events: none;
    background-size: 80px 80px;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
  }

  .tui-page-header {
    justify-content: space-between;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
    display: flex;
  }
  .tui-logo {
    font-family: monospace;
    align-items: center;
    gap: .5rem;
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    display: flex;
  }
  .logo-icon {
    color: #8b7cf8;
  }
  .logo-text {
    letter-spacing: -.03em;
    background: linear-gradient(135deg, #fff 40%, #8b7cf8 100%);
    -webkit-text-fill-color: transparent;
    -webkit-background-clip: text;
  }
  .logo-blink {
    color: #8b7cf8;
    animation: 1s infinite cursor-blink;
  }
  @keyframes cursor-blink {
    0%, to { opacity: 0; }
    50% { opacity: 1; }
  }

  .tui-page-header-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .back-link {
    color: rgba(255, 255, 255, 0.5);
    font-family: monospace;
    border: 1px solid #ffffff14;
    transition: all 0.2s;
    border-radius: 6px;
    padding: .4rem .8rem;
    font-size: .85rem;
    text-decoration: none;
  }
  .back-link:hover {
    color: #8b7cf8;
    border-color: #8b7cf8;
    background: rgba(139, 124, 248, 0.05);
  }
  .lang-toggle-btn {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lang-toggle-btn:hover {
    background: rgba(139, 124, 248, 0.15);
    border-color: rgba(139, 124, 248, 0.4);
    color: #fff;
    box-shadow: 0 0 10px rgba(139, 124, 248, 0.2);
  }

  .tui-page-main {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 1.5rem 4rem;
  }

  .tui-page-section-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 3rem;
  }
  .section-tag {
    font-family: monospace;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #8b7cf8;
    background: rgba(139, 124, 248, 0.08);
    border: 1px solid rgba(139, 124, 248, 0.2);
    border-radius: 100px;
    margin-bottom: 1rem;
    padding: .3rem .8rem;
    font-size: .7rem;
    display: inline-block;
  }
  .section-title {
    font-family: var(--font-heading, inherit);
    color: #ffffff;
    letter-spacing: -.01em;
    margin-bottom: 1rem;
    font-size: 2.6rem;
    font-weight: 700;
    overflow-wrap: break-word;
  }
  .section-subtitle {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1.1rem;
    line-height: 1.6;
  }
  .lang-note {
    color: rgba(255, 255, 255, 0.35);
    font-family: monospace;
    font-size: 0.78rem;
    margin-top: 0.75rem;
  }

  @media (max-width: 480px) {
    .section-title {
      font-size: 2rem;
    }
  }
</style>
