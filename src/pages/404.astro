---
import Layout from '../layouts/Layout.astro';
---
<Layout title="404 — postctl" titleDe="404 — postctl" noindex>
	<main class="nf">
		<p class="nf-code">404</p>
		<h1>Page not found <span class="nf-sep">·</span> Seite nicht gefunden</h1>
		<pre class="nf-term"><code>$ postctl open this-page
error: no such post, no such page.

$ postctl list --status scheduled   # try the home page instead</code></pre>
		<p class="nf-links"><a href="/">← Home</a> <span>·</span> <a href="/docs/">Docs</a> <span>·</span> <a href="/de/">Startseite (DE)</a></p>
	</main>
</Layout>
<style>
	.nf { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem 1.25rem; gap: 1.25rem; }
	.nf-code { font-family: var(--font-heading); font-size: clamp(4rem, 14vw, 8rem); font-weight: 700; line-height: 1; background: linear-gradient(135deg, #fff, var(--accent)); -webkit-background-clip: text; background-clip: text; color: transparent; }
	.nf h1 { font-family: var(--font-heading); font-size: clamp(1.2rem, 3vw, 1.8rem); }
	.nf-sep { color: var(--accent); }
	.nf-term { text-align: left; max-width: 100%; overflow-x: auto; padding: 1.1rem 1.4rem; background: #11111b; border: 1px solid var(--border); border-radius: 12px; font-family: var(--font-mono); font-size: .85rem; color: #cdd6f4; }
	.nf-links { display: flex; gap: .75rem; flex-wrap: wrap; justify-content: center; color: var(--text-muted); }
	.nf-links a { color: var(--accent); text-decoration: none; }
	.nf-links a:hover { text-decoration: underline; }
</style>
