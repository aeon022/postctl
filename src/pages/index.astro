---
import Layout from '../layouts/Layout.astro';
import { 
  FileText, 
  Terminal, 
  Bot, 
  Zap, 
  BookOpen, 
  Lock, 
  Database, 
  ShieldCheck, 
  UserCheck, 
  LayoutDashboard, 
  MessageSquare, 
  Calendar, 
  Settings, 
  Edit,
  Heart,
  Cloud,
  Users,
  Timer,
  Activity,
  Clock,
  Hourglass,
  Fingerprint,
  Trash2
} from '@lucide/astro';
import mockDashboard from '../mockups/dashboard.html?raw';
import mockPosts from '../mockups/posts.html?raw';
import mockEditor from '../mockups/editor.html?raw';
import mockCalendar from '../mockups/calendar.html?raw';
import mockSchedule from '../mockups/schedule.html?raw';
import mockHistory from '../mockups/history.html?raw';
import mockSettings from '../mockups/settings.html?raw';
import FooterSignature from '../components/FooterSignature.astro';
---


<Layout>
	<!-- Decorative Grid & Glow Background -->
	<div class="bg-glow bg-glow-1"></div>
	<div class="bg-glow bg-glow-2"></div>
	<div class="grid-overlay"></div>

	<!-- Navigation Header -->
	<header class="header">
		<div class="header-capsule">
			<div class="logo">
				<a href="/" class="logo-link">
					<span class="logo-icon">&gt;_</span>
					<span class="logo-text">postctl<span class="logo-blink">_</span></span>
				</a>
				<span class="system-status"><span class="status-dot"></span>SYS_OK</span>
			</div>
			<nav class="nav" id="main-nav">
				<a href="#channels" class="nav-link"><span class="lang-en">Channels</span><span class="lang-de">Kanäle</span></a>
				<a href="#tour" class="nav-link"><span class="lang-en">Tour</span><span class="lang-de">Tour</span></a>
				<a href="#features" class="nav-link"><span class="lang-en">Features</span><span class="lang-de">Funktionen</span></a>
				<a href="#profiles" class="nav-link"><span class="lang-en">Profiles</span><span class="lang-de">Profile</span></a>
				<a href="#safety" class="nav-link"><span class="lang-en">Safety</span><span class="lang-de">Sicherheit</span></a>
				<a href="/docs" class="nav-link"><span class="lang-en">Docs</span><span class="lang-de">Doku</span></a>
				<a href="#pricing" class="nav-link"><span class="lang-en">Pricing</span><span class="lang-de">Preise</span></a>
				<a href="https://buy.polar.sh/polar_cl_wQUHDTz9e8ZLhWS59jxxRaBGiNjdaWIHpwt4T4fyzhW" target="_blank" rel="noopener noreferrer" class="nav-link"><span class="lang-en">Donate</span><span class="lang-de">Spenden</span></a>
				<a href="https://github.com/aeon022/postctl" target="_blank" rel="noopener noreferrer" class="nav-link github-link">
					<svg height="14" viewBox="0 0 16 16" width="14" class="github-icon"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"></path></svg>
					<span>GitHub</span>
				</a>
				<a id="lang-toggle" href="__ALT_LANG_URL__" class="lang-toggle-btn" aria-label="Switch language" style="text-decoration:none;display:inline-flex;align-items:center;background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; padding: 0.25rem 0.6rem; border-radius: 6px; font-size: 0.75rem; font-weight: 600; cursor: pointer; transition: all 0.2s ease;">
					<span class="lang-en">DE</span>
					<span class="lang-de">EN</span>
				</a>
			</nav>
			<button id="mobile-nav-toggle" class="mobile-nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="main-nav">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
			</button>
		</div>
	</header>

	<main>
		<!-- Hero Section -->
		<section class="hero-section">
			<canvas id="hero-net" class="hero-net" aria-hidden="true"></canvas>
			<div class="container hero-container">
				<div class="hero-content">
					<div class="badge">
						<span class="lang-en">100% Local · No Cloud</span>
						<span class="lang-de">100% Lokal · Keine Cloud</span>
					</div>
					<h1 class="hero-title">
						<span class="lang-en">Social Media Management from your <span class="text-gradient">Terminal</span></span>
						<span class="lang-de">Social Media Management aus deinem <span class="text-gradient">Terminal</span></span>
					</h1>
					<p class="hero-subtitle">
						<span class="lang-en">A Markdown-first, terminal-native post scheduler. 100% free and open-source for up to 2 social networks, with optional donations. Manage Instagram, Facebook, Threads, X, LinkedIn, Bluesky, Mastodon, Telegram, and Discord directly from the CLI or TUI.</span>
						<span class="lang-de">Ein Markdown-first, Terminal-nativer Post-Scheduler. 100% kostenlos und Open-Source für bis zu 2 soziale Netzwerke. Verwalte Instagram, Facebook, Threads, X, LinkedIn, Bluesky, Mastodon, Telegram und Discord direkt über die CLI oder TUI.</span>
					</p>
					<div class="hero-ctas">
						<a href="#channels" class="btn btn-primary">
							<span class="lang-en">See Channels</span>
							<span class="lang-de">Kanäle ansehen</span>
						</a>
						<a href="#tour" class="btn btn-secondary">
							<span class="lang-en">Take the Tour</span>
							<span class="lang-de">Zur Tour</span>
						</a>
						<a href="https://buy.polar.sh/polar_cl_wQUHDTz9e8ZLhWS59jxxRaBGiNjdaWIHpwt4T4fyzhW" target="_blank" rel="noopener noreferrer" class="btn btn-tertiary">
							<Heart class="heart-icon" size={14} /> 
							<span class="lang-en">Support postctl</span>
							<span class="lang-de">postctl unterstützen</span>
						</a>
					</div>
				</div>
				
				<!-- Real TUI screenshot (generated from the app, fictional demo data) -->
				<div class="hero-terminal mock-window">
					<div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl</span></div>
					<div class="mock-body"><pre class="mock-pre mock-pre-hero" set:html={mockDashboard}></pre><div class="mock-scan" aria-hidden="true"></div><div class="mock-toast" id="mock-toast" aria-hidden="true"></div></div>
				</div>
			</div>
		</section>

		<!-- Channels -->
		<section id="channels" class="channels-section">
			<div class="container">
				<div class="section-header">
					<div class="section-tag"><span class="lang-en">One tool, every channel</span><span class="lang-de">Ein Tool, alle Kanäle</span></div>
					<h2 class="section-title"><span class="lang-en">Write once, publish everywhere</span><span class="lang-de">Einmal schreiben, überall veröffentlichen</span></h2>
					<p class="section-subtitle"><span class="lang-en">Feed posts, carousels and stories on Instagram, photo posts on Facebook pages, carousels on Threads — plus X, LinkedIn, Bluesky, Mastodon, Telegram and Discord. What each network can do, postctl does.</span><span class="lang-de">Feed-Posts, Carousels und Stories auf Instagram, Foto-Posts auf Facebook-Seiten, Carousels auf Threads — dazu X, LinkedIn, Bluesky, Mastodon, Telegram und Discord. Was ein Netzwerk kann, kann auch postctl.</span></p>
				</div>
				<div class="matrix-wrap">
					<table class="matrix">
						<thead><tr><th></th><th><span class="lang-en">Text</span><span class="lang-de">Text</span></th><th><span class="lang-en">Images</span><span class="lang-de">Bilder</span></th><th><span class="lang-en">Carousel</span><span class="lang-de">Carousel</span></th><th><span class="lang-en">Story</span><span class="lang-de">Story</span></th><th><span class="lang-en">Alt text</span><span class="lang-de">Alt-Text</span></th><th><span class="lang-en">Delete via API</span><span class="lang-de">Löschen per API</span></th></tr></thead>
						<tbody><tr><th>Instagram</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td></tr><tr><th>Facebook Page</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td></tr><tr><th>Threads</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td></tr><tr><th>X / Twitter</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td></tr><tr><th>LinkedIn (profile + page)</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td></tr><tr><th>Bluesky</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td></tr><tr><th>Mastodon</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td></tr><tr><th>Telegram · Discord</th><td><span class="ok">✓</span></td><td><span class="ok">✓</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="no">–</span></td><td><span class="ok">✓</span></td></tr></tbody>
					</table>
				</div>
				<p class="matrix-note"><span class="lang-en">Instagram does not allow deleting posts through its API — remove them in the app. Capabilities follow what each platform's API offers.</span><span class="lang-de">Instagram erlaubt kein Löschen per API — Posts dort in der App entfernen. Die Fähigkeiten folgen dem, was die API der jeweiligen Plattform anbietet.</span></p>
			</div>
		</section>

		<!-- TUI tour -->
		<section id="tour" class="tour-section">
			<div class="container">
				<div class="section-header">
					<div class="section-tag"><span class="lang-en">The terminal UI</span><span class="lang-de">Die Terminal-UI</span></div>
					<h2 class="section-title"><span class="lang-en">Take the tour</span><span class="lang-de">Die Tour</span></h2>
					<p class="section-subtitle"><span class="lang-en">These are real screens of postctl (with made-up demo data), rendered straight from the app. Mouse and keyboard both work.</span><span class="lang-de">Das sind echte Ansichten von postctl (mit erfundenen Demo-Daten), direkt aus der App gerendert. Maus und Tastatur funktionieren beide.</span></p>
				</div>
				<div class="tour-tabs" role="tablist"><button class="tour-tab active" data-tour="dashboard"><span class="lang-en">Dashboard</span><span class="lang-de">Dashboard</span></button><button class="tour-tab" data-tour="posts"><span class="lang-en">Posts</span><span class="lang-de">Posts</span></button><button class="tour-tab" data-tour="editor"><span class="lang-en">Editor</span><span class="lang-de">Editor</span></button><button class="tour-tab" data-tour="calendar"><span class="lang-en">Calendar</span><span class="lang-de">Kalender</span></button><button class="tour-tab" data-tour="schedule"><span class="lang-en">Queue</span><span class="lang-de">Queue</span></button><button class="tour-tab" data-tour="history"><span class="lang-en">History</span><span class="lang-de">Verlauf</span></button><button class="tour-tab" data-tour="settings"><span class="lang-en">Settings</span><span class="lang-de">Einstellungen</span></button></div>
				<div class="tour-panels"><div class="tour-panel active" id="tour-dashboard">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — dashboard</span></div>
						<pre class="mock-pre" set:html={mockDashboard}></pre></div>
						<p class="tour-caption"><span class="lang-en">Campaign progress, the next posts, platform health and token expiry at a glance.</span><span class="lang-de">Kampagnenfortschritt, nächste Posts, Plattform-Status und Token-Ablauf auf einen Blick.</span></p>
					</div><div class="tour-panel" id="tour-posts">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — posts</span></div>
						<pre class="mock-pre" set:html={mockPosts}></pre></div>
						<p class="tour-caption"><span class="lang-en">Filter, search with /, select several posts, publish now or schedule — all from the keyboard.</span><span class="lang-de">Filtern, mit / suchen, mehrere Posts markieren, sofort posten oder planen — komplett per Tastatur.</span></p>
					</div><div class="tour-panel" id="tour-editor">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — editor</span></div>
						<pre class="mock-pre" set:html={mockEditor}></pre></div>
						<p class="tour-caption"><span class="lang-en">Live preview, character counter, alt text per image and one post for several platforms at once.</span><span class="lang-de">Live-Vorschau, Zeichenzähler, Alt-Text pro Bild und ein Post für mehrere Plattformen gleichzeitig.</span></p>
					</div><div class="tour-panel" id="tour-calendar">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — calendar</span></div>
						<pre class="mock-pre" set:html={mockCalendar}></pre></div>
						<p class="tour-caption"><span class="lang-en">Month grid with brand-coloured dots per platform. Click a day to see what goes out.</span><span class="lang-de">Monatsraster mit markenfarbigen Punkten pro Plattform. Ein Klick auf den Tag zeigt, was rausgeht.</span></p>
					</div><div class="tour-panel" id="tour-schedule">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — queue</span></div>
						<pre class="mock-pre" set:html={mockSchedule}></pre></div>
						<p class="tour-caption"><span class="lang-en">The publishing queue with the scheduler status and the next check.</span><span class="lang-de">Die Veröffentlichungs-Queue mit Scheduler-Status und nächstem Check.</span></p>
					</div><div class="tour-panel" id="tour-history">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — history</span></div>
						<pre class="mock-pre" set:html={mockHistory}></pre></div>
						<p class="tour-caption"><span class="lang-en">Every publish with platform ID and error text — plus re-publish and details.</span><span class="lang-de">Jede Veröffentlichung mit Plattform-ID und Fehlertext — samt Details.</span></p>
					</div><div class="tour-panel" id="tour-settings">
						<div class="mock-window"><div class="mock-chrome"><span class="tui-dot tui-dot-red"></span><span class="tui-dot tui-dot-yellow"></span><span class="tui-dot tui-dot-green"></span><span class="mock-title">postctl — settings</span></div>
						<pre class="mock-pre" set:html={mockSettings}></pre></div>
						<p class="tour-caption"><span class="lang-en">Connect platforms, install the scheduler service, switch the colour theme live.</span><span class="lang-de">Plattformen verbinden, Scheduler-Dienst installieren, Farbschema live umschalten.</span></p>
					</div></div>
			</div>
		</section>

		<!-- Features Grid Section -->
		<section id="features" class="features-section">
			<div class="container">
				<div class="section-header">
					<h2 class="section-title"><span class="lang-en">Built for Developer Workflows</span><span class="lang-de">Für Entwickler-Workflows gebaut</span></h2>
					<p class="section-subtitle"><span class="lang-en">Why switch to bloated web UIs when you can distribute your content alongside your code?</span><span class="lang-de">Wozu aufgeblähte Web-UIs, wenn du deine Inhalte direkt neben deinem Code verwalten kannst?</span></p>
				</div>

				<div class="features-grid">
					<!-- Feature 1 -->
					<div class="feature-card">
						<div class="feature-icon"><FileText size={40} /></div>
						<h3 class="feature-title"><span class="lang-en">Markdown-First</span><span class="lang-de">Markdown-First</span></h3>
						<p class="feature-desc"><span class="lang-en">Write your posts inside your favorite editor. Frontmatter fields handle platform targets, scheduling, and image paths. Perfectly Git-versionable and reviewable in PRs.</span><span class="lang-de">Schreibe deine Posts in deinem Lieblingseditor. Frontmatter-Felder steuern Plattform-Ziele, Zeitplanung und Bildpfade. Perfekt Git-versionierbar und in PRs überprüfbar.</span></p>
					</div>
					<!-- Feature 2 -->
					<div class="feature-card">
						<div class="feature-icon"><Terminal size={40} /></div>
						<h3 class="feature-title"><span class="lang-en">Interactive TUI Editor</span><span class="lang-de">Interaktiver TUI-Editor</span></h3>
						<p class="feature-desc"><span class="lang-en">Draft and edit posts directly inside the terminal. Form validations catch platform errors, automatic splitting parses Twitter threads, and `ctrl+v` opens Neovim/Vim instantly.</span><span class="lang-de">Entwirf und bearbeite Posts direkt im Terminal. Formularvalidierungen fangen Plattformfehler ab, automatisches Splitting zerlegt Twitter-Threads, und `ctrl+v` öffnet sofort Neovim/Vim.</span></p>
					</div>
					<!-- Feature 3 -->
					<div class="feature-card">
						<div class="feature-icon"><Bot size={40} /></div>
						<h3 class="feature-title"><span class="lang-en">AI-as-Operator</span><span class="lang-de">KI-als-Operator</span></h3>
						<p class="feature-desc"><span class="lang-en">Engineered for AI assistants. Claude/GPT can generate Markdown draft files, test publication flows with `--dry-run`, and receive machine-readable outcomes using `--format json`.</span><span class="lang-de">Für KI-Assistenten konzipiert. Claude/GPT können Markdown-Entwürfe erzeugen, Veröffentlichungsabläufe mit `--dry-run` testen und mit `--format json` maschinenlesbare Ergebnisse erhalten.</span></p>
					</div>
					<!-- Feature 4 -->
					<div class="feature-card">
						<div class="feature-icon"><Zap size={40} /></div>
						<h3 class="feature-title"><span class="lang-en">Zero Infrastructure</span><span class="lang-de">Keine Infrastruktur nötig</span></h3>
						<p class="feature-desc"><span class="lang-en">Built in Go with a CGO-free SQLite storage engine. Packaged as a single offline-first binary. Copy the database file to backup all your posts and schedules.</span><span class="lang-de">Gebaut in Go mit einer CGO-freien SQLite-Speicher-Engine. Verpackt als einzelnes Offline-First-Binary. Kopiere einfach die Datenbankdatei, um alle Posts und Zeitpläne zu sichern.</span></p>
					</div>
					<!-- Feature 5 -->
					<div class="feature-card">
						<div class="feature-icon"><BookOpen size={40} /></div>
						<h3 class="feature-title"><span class="lang-en">Offline Documentation</span><span class="lang-de">Offline-Dokumentation</span></h3>
						<p class="feature-desc"><span class="lang-en">Access the full README directly inside the app with a split-pane layout, interactive table of contents, and responsive terminal scrolling—no browser required.</span><span class="lang-de">Greife direkt in der App auf das komplette README zu — mit geteiltem Layout, interaktivem Inhaltsverzeichnis und responsivem Terminal-Scrolling, ganz ohne Browser.</span></p>
					</div>
					<!-- Feature 6 -->
					<div class="feature-card">
						<div class="feature-icon"><Lock size={40} /></div>
						<h3 class="feature-title"><span class="lang-en">AES-256 Encrypted Sync</span><span class="lang-de">AES-256-verschlüsselte Sync</span></h3>
						<p class="feature-desc"><span class="lang-en">Securely sync your local database and config files. Backups are encrypted using AES-256-GCM and key-stretched (PBKDF2) for safe storage in public Git repos.</span><span class="lang-de">Synchronisiere deine lokale Datenbank und Konfigurationsdateien sicher. Backups werden mit AES-256-GCM verschlüsselt und per PBKDF2 key-gestreckt — sicher auch in öffentlichen Git-Repos.</span></p>
					</div>
					<!-- Feature 7 -->
					<div class="feature-card">
						<div class="feature-icon"><Cloud size={40} /></div>
						<h3 class="feature-title">
							<span class="lang-en">Cloud Deployment (VPS/Pi)</span>
							<span class="lang-de">Cloud-Bereitstellung (VPS/Pi)</span>
						</h3>
						<p class="feature-desc">
							<span class="lang-en">Cross-compile to Linux and run postctl as a background daemon on a VPS or Raspberry Pi. Posts publish automatically, even when your Mac is shut down.</span>
							<span class="lang-de">Kompiliere für Linux und lasse postctl als Hintergrund-Daemon auf einem VPS oder Raspberry Pi laufen. Posts werden automatisch gesendet, auch wenn dein Mac aus ist.</span>
						</p>
					</div>
				</div>
			</div>
		</section>

		<!-- How it Works Section (NEW) -->
		<section id="how-it-works" class="how-section">
			<div class="container">
				<div class="section-header">
					<h2 class="section-title"><span class="lang-en">How It Works</span><span class="lang-de">So funktioniert's</span></h2>
					<p class="section-subtitle"><span class="lang-en">Three steps from draft file to multi-platform publication.</span><span class="lang-de">Drei Schritte von der Entwurfsdatei bis zur Veröffentlichung auf mehreren Plattformen.</span></p>
				</div>

				<div class="how-grid">
					<!-- Step 1 -->
					<div class="how-step-card">
						<div class="step-num">01</div>
						<div class="step-text-col">
							<h3 class="step-title"><span class="lang-en">Write Markdown Posts</span><span class="lang-de">Posts in Markdown schreiben</span></h3>
