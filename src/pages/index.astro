	/* ── Mockups, channels, tour, info cards ─────────────────── */
	.mock-window { container-type: inline-size; background: #11111b; border: 1px solid var(--border); border-radius: 12px; overflow: hidden; box-shadow: 0 20px 60px rgba(0,0,0,.45); }
	.mock-chrome { display: flex; align-items: center; gap: 6px; padding: .55rem .8rem; background: #181825; border-bottom: 1px solid var(--border); }
	.mock-title { margin-left: .6rem; font-family: var(--font-mono); font-size: .72rem; color: rgba(255,255,255,.4); }
	.mock-pre { margin: 0; padding: .9rem 1rem 1.1rem; overflow-x: auto; background: #11111b; color: #cdd6f4; font-family: var(--font-mono); font-size: clamp(5px, 1.3cqw, 12px); line-height: 1.32; white-space: pre; }
	.mock-pre-hero { overflow: hidden; font-size: clamp(3.4px, 1.3cqw, 12px); }
	.mock-window.hero-terminal { max-width: 100%; }
	.channels-section, .tour-section, .profiles-section, .markdown-section, .safety-section { padding: 6rem 0; }
	.matrix-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-secondary); }
	.matrix { width: 100%; border-collapse: collapse; font-size: .92rem; }
	.matrix th, .matrix td { padding: .85rem 1rem; text-align: center; border-bottom: 1px solid var(--border); }
	.matrix tbody th { text-align: left; font-weight: 600; color: var(--text-primary, #e2e8f0); white-space: nowrap; }
	.matrix thead th { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.5); }
	.matrix tr:last-child th, .matrix tr:last-child td { border-bottom: none; }
	.matrix .ok { color: #a6e3a1; font-weight: 700; } .matrix .no { color: rgba(255,255,255,.2); }
	.matrix-note, .suite-note { text-align: center; margin-top: 1rem; font-size: .82rem; color: rgba(255,255,255,.45); }
	.suite-note { margin-top: 2.5rem; font-size: .95rem; } .suite-note :global(a) { color: var(--accent); }
	.tour-tabs { display: flex; flex-wrap: wrap; gap: .5rem; justify-content: center; margin-bottom: 1.5rem; }
	.tour-tab { min-height: 40px; background: var(--bg-secondary); border: 1px solid var(--border); color: rgba(255,255,255,.65); padding: .5rem 1rem; border-radius: 999px; font-family: var(--font-mono); font-size: .78rem; cursor: pointer; transition: var(--transition); }
	.tour-tab:hover { border-color: var(--accent); color: #fff; }
	.tour-tab.active { background: var(--accent); border-color: var(--accent); color: #fff; }
	.tour-panel { display: none; max-width: 980px; margin: 0 auto; }
	.tour-panel.active { display: block; }
	.tour-caption { text-align: center; margin-top: 1rem; color: rgba(255,255,255,.6); font-size: .95rem; }
	.info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.25rem; }
	.info-card { background: var(--bg-secondary); border: 1px solid var(--border); border-radius: 12px; padding: 1.75rem; transition: var(--transition); }
	.info-card:hover { border-color: var(--accent); transform: translateY(-3px); }
	.info-icon { font-size: 1.6rem; margin-bottom: .75rem; }
	.info-card h3 { font-size: 1.05rem; margin: 0 0 .5rem; }
	.info-card p { margin: 0; color: rgba(255,255,255,.65); font-size: .92rem; line-height: 1.55; }
	.md-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem; }
	.md-code { margin: 0; padding: 1.25rem 1.4rem; background: #11111b; border: 1px solid var(--border); border-radius: 12px; overflow-x: auto; font-family: var(--font-mono); font-size: .8rem; line-height: 1.5; color: #cdd6f4; }

	.info-icon { display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 10px; background: rgba(139,124,248,.12); color: var(--accent); margin-bottom: 1rem; font-size: 0; }
	.mock-body { position: relative; }
	.mock-scan { position: absolute; left: calc(1rem + 3ch); width: 59ch; height: 1.32em; top: calc(.9rem + 19 * 1.32em); font-size: clamp(5px, 1.3cqw, 12px); background: rgba(139,124,248,.22); border-left: 2px solid var(--accent); border-radius: 2px; pointer-events: none; animation: mock-scan 16s steps(8, jump-none) infinite; }
	@keyframes mock-scan { from { transform: translateY(0); } to { transform: translateY(calc(7 * 1.32em)); } }
	.mock-toast { position: absolute; right: 4%; bottom: 7%; max-width: 70%; padding: .45em .8em; background: rgba(24,24,37,.96); border: 1px solid rgba(166,227,161,.45); border-radius: 8px; font-family: var(--font-mono); font-size: clamp(7px, 1.25cqw, 12px); color: #cdd6f4; opacity: 0; transform: translateY(8px); transition: opacity .35s ease, transform .35s ease; box-shadow: 0 8px 28px rgba(0,0,0,.45); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.mock-toast.on { opacity: 1; transform: translateY(0); }
	.mock-toast :global(.t-ok) { color: #a6e3a1; font-weight: 700; }
	.bg-glow { will-change: translate; }
	.bg-glow-1 { animation: glow-drift 22s ease-in-out infinite alternate; }
	.bg-glow-2 { animation: glow-drift 28s ease-in-out infinite alternate-reverse; }
	@keyframes glow-drift { from { transform: translate(0,0) scale(1); } to { transform: translate(40px,-30px) scale(1.12); } }
	.reveal { transition-property: opacity, transform; }
	@media (prefers-reduced-motion: reduce) { .mock-scan, .bg-glow-1, .bg-glow-2 { animation: none; } .reveal { opacity: 1 !important; transform: none !important; } }

	.hero-net { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; pointer-events: none; opacity: .75; mask-image: radial-gradient(ellipse at 60% 45%, #000 20%, transparent 75%); -webkit-mask-image: radial-gradient(ellipse at 60% 45%, #000 20%, transparent 75%); }
	.hero-section { position: relative; }
	.hero-section .hero-container { position: relative; z-index: 1; }

	@media (max-width: 760px) {
		.channels-section, .tour-section, .profiles-section, .markdown-section, .safety-section { padding: 4rem 0; }
		.tour-panel .mock-pre { font-size: 8.5px; } /* readable, scrolls sideways instead of shrinking to dust */
		.tour-tabs { flex-wrap: nowrap; overflow-x: auto; justify-content: flex-start; padding-bottom: .4rem; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
		.tour-tab { flex: 0 0 auto; }
		.matrix th, .matrix td { padding: .7rem .6rem; font-size: .82rem; }
		.md-grid { grid-template-columns: 1fr; }
		.mock-toast { display: none; }
	}
	.mock-pre, .md-code, .matrix-wrap { max-width: 100%; }
	.plan-note { margin-top: .9rem; text-align: center; font-size: .78rem; color: rgba(255,255,255,.5); line-height: 1.5; }
	.plan-note a { color: var(--accent); }
</style>

<script>
	// TUI tour tabs
	const tourTabs = document.querySelectorAll<HTMLElement>('.tour-tab');
	const tourPanels = document.querySelectorAll<HTMLElement>('.tour-panel');
	tourTabs.forEach((btn) => btn.addEventListener('click', () => {
		const id = btn.dataset.tour;
		tourTabs.forEach((b) => b.classList.toggle('active', b === btn));
		tourPanels.forEach((p) => p.classList.toggle('active', p.id === `tour-${id}`));
	}));

	// ── Hero motion: toast cycle + soft parallax (skipped for reduced motion) ──
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const toast = document.getElementById('mock-toast');
	if (toast && !reduceMotion) {
		const msgs = [
			['Instagram', 'Summer Menu — teaser'],
			['Threads', 'Summer Menu — teaser'],
			['X', 'Summer Menu — teaser'],
			['Facebook', 'Summer Menu — teaser'],
			['LinkedIn', 'We are hiring a line cook'],
		];
		let mi = 0;
		const showToast = () => {
			const [pl, ti] = msgs[mi++ % msgs.length];
			toast.innerHTML = `<span class="t-ok">✓ published</span> <b>${pl}</b> · ${ti}`;
			toast.classList.add('on');
			setTimeout(() => toast.classList.remove('on'), 2600);
		};
		setTimeout(() => { showToast(); setInterval(showToast, 4200); }, 1800);
	}
	if (!reduceMotion) {
		const heroMock = document.querySelector<HTMLElement>('.hero-terminal');
		const glows = document.querySelectorAll<HTMLElement>('.bg-glow');
		let ticking = false;
		window.addEventListener('scroll', () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				const y = Math.min(window.scrollY, 900);
				if (heroMock) heroMock.style.transform = `translateY(${y * -0.05}px)`;
				glows.forEach((g, i) => g.style.translate = `0 ${y * (i ? 0.12 : 0.2)}px`);
				ticking = false;
			});
		}, { passive: true });
	}

	// ── Hero background: drifting network, packets travel between nodes (= posts going out) ──
	const netCanvas = document.getElementById('hero-net') as HTMLCanvasElement | null;
	if (netCanvas && !reduceMotion) {
		const ctx = netCanvas.getContext('2d')!;
		type Node = { x: number; y: number; vx: number; vy: number; r: number };
		type Packet = { a: number; b: number; t: number };
		let W = 0, H = 0, nodes: Node[] = [], packets: Packet[] = [], visible = true, raf = 0;
		const dpr = Math.min(window.devicePixelRatio || 1, 2);
		const resize = () => {
			const r = netCanvas.getBoundingClientRect();
			W = r.width; H = r.height;
			netCanvas.width = W * dpr; netCanvas.height = H * dpr;
			ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
			const n = Math.round(Math.min(70, Math.max(24, (W * H) / 20000)));
			nodes = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, vx: (Math.random() - .5) * .25, vy: (Math.random() - .5) * .25, r: 1 + Math.random() * 1.6 }));
		};
		const LINK = 150;
		const frame = () => {
			raf = 0;
			if (!visible || document.hidden) return;
			ctx.clearRect(0, 0, W, H);
			for (const n of nodes) {
				n.x += n.vx; n.y += n.vy;
				if (n.x < -10) n.x = W + 10; else if (n.x > W + 10) n.x = -10;
				if (n.y < -10) n.y = H + 10; else if (n.y > H + 10) n.y = -10;
			}
			for (let i = 0; i < nodes.length; i++) {
				for (let j = i + 1; j < nodes.length; j++) {
					const dx = nodes[i].x - nodes[j].x, dy = nodes[i].y - nodes[j].y, d = Math.hypot(dx, dy);
					if (d < LINK) {
						ctx.strokeStyle = `rgba(139,124,248,${(1 - d / LINK) * 0.22})`;
						ctx.lineWidth = 1;
						ctx.beginPath(); ctx.moveTo(nodes[i].x, nodes[i].y); ctx.lineTo(nodes[j].x, nodes[j].y); ctx.stroke();
					}
				}
			}
			ctx.fillStyle = 'rgba(190,180,255,.55)';
			for (const n of nodes) { ctx.beginPath(); ctx.arc(n.x, n.y, n.r, 0, 6.283); ctx.fill(); }
			if (packets.length < 6 && Math.random() < 0.03) {
				const a = Math.floor(Math.random() * nodes.length);
				let best = -1, bd = LINK;
				for (let k = 0; k < nodes.length; k++) if (k !== a) { const d = Math.hypot(nodes[a].x - nodes[k].x, nodes[a].y - nodes[k].y); if (d < bd) { bd = d; best = k; } }
				if (best >= 0) packets.push({ a, b: best, t: 0 });
			}
			packets = packets.filter((p) => (p.t += 0.018) < 1);
			for (const p of packets) {
				const A = nodes[p.a], B = nodes[p.b];
				const x = A.x + (B.x - A.x) * p.t, y = A.y + (B.y - A.y) * p.t;
				ctx.fillStyle = 'rgba(166,227,161,.95)';
				ctx.shadowColor = 'rgba(166,227,161,.9)'; ctx.shadowBlur = 10;
				ctx.beginPath(); ctx.arc(x, y, 2.2, 0, 6.283); ctx.fill();
				ctx.shadowBlur = 0;
			}
			raf = requestAnimationFrame(frame);
		};
		const kick = () => { if (!raf) raf = requestAnimationFrame(frame); };
		resize(); kick();
		window.addEventListener('resize', () => { resize(); kick(); });
		document.addEventListener('visibilitychange', kick);
		new IntersectionObserver((e) => { visible = e[0].isIntersecting; kick(); }).observe(netCanvas);
	}

	// ── Back to top ──────────────────────────────────────────
	const backToTopBtn = document.getElementById('back-to-top');

	function smoothScrollTo(targetY: number, duration: number = 600) {
		const startY = window.scrollY;
		const diff = targetY - startY;
		let startTime: number | null = null;

		function ease(t: number) {
			return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
		}

		function step(now: number) {
			if (!startTime) startTime = now;
			const elapsed = now - startTime;
			const progress = Math.min(elapsed / duration, 1);
			window.scrollTo(0, startY + diff * ease(progress));
			if (progress < 1) requestAnimationFrame(step);
		}
		requestAnimationFrame(step);
	}

	window.addEventListener('scroll', () => {
		if (window.scrollY > 400) {
			backToTopBtn?.classList.add('visible');
		} else {
			backToTopBtn?.classList.remove('visible');
		}
		updateActiveNav();
	}, { passive: true });

	backToTopBtn?.addEventListener('click', () => {
		backToTopBtn.style.transform = 'scale(0.92)';
		setTimeout(() => { backToTopBtn.style.transform = ''; }, 150);
		smoothScrollTo(0, 700);
	});

	// ── Smooth anchor scroll ──────────────────────────────────
	document.querySelectorAll('a[href^="#"]').forEach(anchor => {
		anchor.addEventListener('click', function (e) {
			e.preventDefault();
			const href = (this as HTMLAnchorElement).getAttribute('href');
			if (!href || href === '#') return;
			const target = document.querySelector(href) as HTMLElement;
			if (!target) return;
			const headerOffset = 90;
			const targetY = target.getBoundingClientRect().top + window.scrollY - headerOffset;
			smoothScrollTo(targetY, 800);
		});
	});

	// ── Nav active state on scroll ────────────────────────────
	const navLinks = document.querySelectorAll('.nav-link[href^="#"]');
	const sections = Array.from(navLinks).map(l => {
		const id = (l as HTMLAnchorElement).getAttribute('href')?.slice(1);
		return id ? document.getElementById(id) : null;
	});

	function updateActiveNav() {
		const scrollMid = window.scrollY + window.innerHeight * 0.4;
		let active = -1;
		sections.forEach((sec, i) => {
			if (sec && sec.offsetTop <= scrollMid) active = i;
		});
		navLinks.forEach((l, i) => {
			l.classList.toggle('nav-active', i === active);
		});
	}
	updateActiveNav();

	// ── Scroll reveal ─────────────────────────────────────────
	const revealTargets = document.querySelectorAll(
		'.feature-card, .how-step-card, .ai-workflow-card, .pricing-card, .section-header, .donate-banner, .info-card, .mock-window:not(.hero-terminal), .matrix-wrap, .md-code, .tour-tabs, .suite-note, .roadmap-card, .matrix-note'
	);

	const revealObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach((entry, idx) => {
			if (entry.isIntersecting) {
				const el = entry.target as HTMLElement;
				el.style.transitionDelay = `${Math.min(idx * 0.04, 0.25)}s`;
				el.classList.add('active');
				observer.unobserve(el);
			}
		});
	}, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });

	revealTargets.forEach(el => {
		el.classList.add('reveal');
		revealObserver.observe(el);
	});

</script>
