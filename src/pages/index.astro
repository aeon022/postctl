	@media (max-width: 768px) {
		.mobile-nav-toggle {
			display: inline-flex;
		}
		.nav {
			flex-direction: column;
			align-items: stretch;
			gap: 0.15rem;
			position: absolute;
			top: calc(100% + 0.6rem);
			left: 0;
			right: 0;
			background: rgba(13, 14, 18, 0.96);
			backdrop-filter: blur(20px) saturate(190%);
			border: 1px solid rgba(255, 255, 255, 0.08);
			border-radius: 20px;
			padding: 0.6rem;
			box-shadow: 0 12px 40px rgba(0, 0, 0, 0.6);
			opacity: 0;
			visibility: hidden;
			transform: translateY(-8px);
			transition: var(--transition);
		}
		.nav.nav-open {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}
		.nav .nav-link,
		.nav .github-link,
		.nav .lang-toggle-btn {
			width: 100%;
			justify-content: flex-start;
		}
		.nav-link[href="#how-it-works"],
		.nav-link[href="/tui"] {
			display: flex;
		}
	}
	.nav-link {
		color: var(--text-secondary);
		font-weight: 500;
		font-size: 0.85rem;
		padding: 0.35rem 0.65rem;
		border-radius: 100px;
		transition: var(--transition);
		white-space: nowrap;
		flex-shrink: 0;
	}
	.nav-link:hover {
		color: var(--text-primary);
		background: rgba(255, 255, 255, 0.04);
	}
	.github-link {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.4rem 0.8rem;
		border-radius: 100px;
		background: rgba(139, 124, 248, 0.06);
		border: 1px solid rgba(139, 124, 248, 0.15);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		white-space: nowrap;
		flex-shrink: 0;
	}
	.github-link:hover {
		border-color: var(--accent);
		background: rgba(139, 124, 248, 0.12);
		color: var(--accent-hover);
		box-shadow: 0 0 10px rgba(139, 124, 248, 0.15);
	}

	/* Hero Section */
	.hero-section {
		padding: 7rem 0 5rem 0;
	}
	.hero-container {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 4rem;
		align-items: center;
	}
	@media (max-width: 968px) {
		.hero-container {
			grid-template-columns: 1fr;
			gap: 3.5rem;
		}
	}
	.hero-content {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.badge {
		background: var(--accent-glow);
		color: var(--accent);
		border: 1px solid rgba(139, 124, 248, 0.35);
		padding: 0.35rem 0.85rem;
		border-radius: 100px;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin-bottom: 1.5rem;
		text-transform: uppercase;
	}
	.hero-title {
		font-size: 3.8rem;
		line-height: 1.1;
		margin-bottom: 1.5rem;
	}
	@media (max-width: 640px) {
		.hero-title {
			font-size: 2.8rem;
		}
	}
	.hero-subtitle {
		font-size: 1.15rem;
		color: var(--text-secondary);
		margin-bottom: 2.5rem;
		max-width: 550px;
		line-height: 1.7;
	}
	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem;
		width: 100%;
	}
	
	/* Button Styles */
	.btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		padding: 0.75rem 1.5rem;
		border-radius: 8px;
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
		border: 1px solid transparent;
		transition: var(--transition);
	}
	.btn-primary {
		background: var(--accent);
		color: var(--bg-primary);
	}
	.btn-primary:hover {
		background: var(--accent-hover);
		transform: translateY(-2px);
		box-shadow: 0 4px 20px var(--accent-glow);
	}
	.btn-secondary {
		background: var(--bg-secondary);
		border-color: var(--border);
		color: var(--text-primary);
	}
	.btn-secondary:hover {
		border-color: var(--accent);
		background: var(--bg-tertiary);
		transform: translateY(-2px);
	}
	.btn-tertiary {
		background: transparent;
		border-color: rgba(239, 68, 68, 0.4);
		color: #f87171;
	}
	.btn-tertiary:hover {
		background: rgba(239, 68, 68, 0.08);
		border-color: #ef4444;
		transform: translateY(-2px);
	}
	.btn-full {
		width: 100%;
	}
	.heart-icon {
		color: #ff4a5a;
		fill: #ff4a5a;
		display: inline-block;
		vertical-align: middle;
		margin-right: 0.35rem;
		margin-top: -2px;
	}

	/* Interactive Terminal Emulator */
	.hero-terminal {
		background: #0d0e12;
		border: 1px solid var(--border);
		border-radius: 12px;
		box-shadow: var(--shadow-lg);
		overflow: hidden;
		min-height: 400px;
		display: flex;
		flex-direction: column;
	}
	.terminal-header {
		background: #161920;
		padding: 0.85rem 1.25rem;
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-bottom: 1px solid var(--border);
	}
	.terminal-dots {
		display: flex;
		gap: 0.5rem;
	}
	.dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		display: inline-block;
	}
	.dot-red { background: var(--error); }
	.dot-yellow { background: #f59e0b; }
	.dot-green { background: var(--success); }
	.terminal-title {
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-secondary);
	}
	.terminal-body {
		padding: 1.5rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: #e5e7eb;
		flex-grow: 1;
		line-height: 1.6;
		overflow-y: auto;
	}
	.cursor-blink {
		color: var(--accent);
		animation: blink 1s step-end infinite;
	}
	.terminal-output {
		margin-top: 1rem;
		color: #a3a3a3;
		white-space: pre-wrap;
	}
	.terminal-output.hide {
		display: none;
	}
	@keyframes blink {
		from, to { color: transparent }
		50% { color: var(--accent) }
	}

	/* Section Commons */
	.section-header {
		text-align: center;
		max-width: 700px;
		margin: 0 auto 4.5rem auto;
	}
	.section-title {
		font-size: 2.6rem;
		margin-bottom: 1rem;
		letter-spacing: -0.01em;
	}
	.section-subtitle {
		color: var(--text-secondary);
		font-size: 1.1rem;
		line-height: 1.6;
	}

	/* Features Section */
	.features-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
		background: rgba(17, 19, 24, 0.45);
	}
	.features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 2rem;
	}
	.feature-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 2.25rem;
		transition: var(--transition);
	}
	.feature-card:hover {
		border-color: var(--accent);
		transform: translateY(-4px);
		box-shadow: 0 0 30px rgba(139, 124, 248, 0.05);
	}
	.feature-icon {
		display: inline-block;
		color: var(--accent);
		margin-bottom: 1.5rem;
	}
	.feature-title {
		font-size: 1.3rem;
		margin-bottom: 0.75rem;
	}
	.feature-desc {
		color: var(--text-secondary);
		font-size: 0.95rem;
		line-height: 1.6;
	}

	/* How It Works Section (NEW) */
	.how-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
	}
	.how-grid {
		display: flex;
		flex-direction: column;
		gap: 5rem;
		max-width: 950px;
		margin: 0 auto;
	}
	.how-step-card {
		display: flex;
		align-items: center;
		gap: 4rem;
	}
	.how-step-card.reverse {
		flex-direction: row-reverse;
	}
	@media (max-width: 768px) {
		.how-step-card, .how-step-card.reverse {
			flex-direction: column;
			align-items: flex-start;
			gap: 2rem;
		}
	}
	.step-num {
		font-family: var(--font-heading);
		font-size: 4rem;
		font-weight: 800;
		color: var(--accent);
		opacity: 0.15;
		line-height: 1;
	}
	.step-text-col {
		flex: 1;
	}
	.step-title {
		font-size: 1.6rem;
		margin-bottom: 0.75rem;
	}
	.step-desc {
		color: var(--text-secondary);
		line-height: 1.6;
	}
	.step-visual {
		flex: 1.2;
		background: #0d0e12;
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: #e5e7eb;
		width: 100%;
		max-height: 250px;
		overflow-y: auto;
	}
	.code-block {
		margin: 0;
	}

	/* TUI Emulator Section */
	.tui-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
		background: rgba(17, 19, 24, 0.45);
	}
	.tui-emulator {
		max-width: 900px;
		margin: 0 auto;
		background: #08090b;
		border: 1px solid rgba(255, 255, 255, 0.12);
		border-radius: 12px;
		overflow: hidden;
		box-shadow: var(--shadow-lg);
	}
	.tui-emulator-header {
		background: #111318;
		padding: 0.65rem 1.25rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.1);
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--text-secondary);
	}
	
	/* Mock TUI CSS */
	.tui-app {
		background: #1c1d22;
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: #e5e7eb;
		display: flex;
		flex-direction: column;
		height: 380px;
	}
	.tui-title-bar {
		background: var(--accent);
		color: #000;
		padding: 0.25rem 1rem;
		font-weight: bold;
		text-align: center;
	}
	.tui-tabs {
		display: flex;
		background: #272930;
		border-bottom: 1px solid rgba(255, 255, 255, 0.05);
		overflow-x: auto;
		white-space: nowrap;
		scrollbar-width: none; /* Hide scrollbar for clean UI on Firefox */
		-webkit-overflow-scrolling: touch;
	}
	.tui-tabs::-webkit-scrollbar {
		display: none; /* Hide scrollbar for Chrome/Safari */
	}
	.tui-tab {
		background: transparent;
		border: none;
		outline: none;
		color: var(--text-secondary);
		padding: 0.5rem 1rem;
		font-family: inherit;
		font-size: inherit;
		cursor: pointer;
		transition: var(--transition);
		flex-shrink: 0;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}
	.tab-icon {
		color: var(--text-muted);
		transition: var(--transition);
	}
	.tui-tab:hover {
		color: var(--text-primary);
		background: rgba(255,255,255,0.03);
	}
	.tui-tab:hover .tab-icon {
		color: var(--text-primary);
	}
	.tui-tab.active {
		background: #1c1d22;
		color: var(--accent);
		font-weight: bold;
	}
	.tui-tab.active .tab-icon {
		color: var(--accent);
	}
	.tui-content-area {
		padding: 1.5rem;
		flex-grow: 1;
		overflow-y: auto;
	}
	.tui-tab-content {
		display: none;
	}
	.tui-tab-content.active {
		display: block;
	}
	.tui-sub-header {
		color: var(--accent);
		font-weight: bold;
		border-bottom: 1px solid rgba(139, 124, 248, 0.3);
		padding-bottom: 0.25rem;
		margin-bottom: 1rem;
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}
	.tui-list {
		list-style: none;
	}
	.tui-list li {
		margin-bottom: 0.5rem;
	}
	.tui-muted {
		color: var(--text-muted);
	}
	.color-accent { color: var(--accent); }
	.color-posted { color: var(--success); }
	.color-failed { color: var(--error); }
	.align-right { text-align: right; }
	
	/* Dashboard Specific Mock TUI */
	.dashboard-grid {
		display: grid;
		grid-template-columns: 1.3fr 1fr;
		gap: 2rem;
		height: 100%;
	}
	.border-left {
		border-left: 1px dashed rgba(255, 255, 255, 0.1);
		padding-left: 1.5rem;
	}
	.stats-table {
		width: 100%;
		border-collapse: collapse;
		margin-bottom: 1rem;
	}
	.stats-table td {
		padding: 0.25rem 0;
	}
	.platform-status .status-indicator {
		display: inline-block;
		width: 18px;
		font-weight: bold;
	}
	.platform-status .status-indicator.active {
		color: var(--success);
	}
	.platform-status .status-indicator.inactive {
		color: var(--text-muted);
	}

	/* Posts Mock TUI */
	.posts-list {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.post-item {
		padding: 0.5rem 0.75rem;
		border-radius: 4px;
		border: 1px solid transparent;
	}
	.post-item.selected {
		background: rgba(139, 124, 248, 0.1);
		border-color: rgba(139, 124, 248, 0.4);
	}
	.post-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.25rem;
		font-weight: bold;
	}
	.post-snippet {
		font-size: 0.8rem;
		color: var(--text-primary);
		margin-bottom: 0.25rem;
	}
	.post-meta {
		font-size: 0.75rem;
	}

	/* Schedule Mock TUI */
	.schedule-timeline {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.timeline-event {
		display: flex;
		gap: 1.5rem;
		align-items: flex-start;
	}
	.time-badge {
		background: #272930;
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		font-size: 0.75rem;
		min-width: 90px;
		text-align: center;
	}
	
	/* Settings Mock TUI */
	.settings-list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}
	.setting-row {
		display: flex;
		gap: 1rem;
		padding: 0.25rem 0.5rem;
	}
	.setting-row.cursor-pointing {
		background: rgba(255, 255, 255, 0.03);
		border-left: 2px solid var(--accent);
	}
	.setting-label {
		color: var(--text-secondary);
		min-width: 120px;
	}

	/* Editor Mock TUI */
	.editor-mock {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		font-size: 0.76rem;
	}
	.editor-row {
		margin-bottom: 0.1rem;
	}
	.editor-input-mock {
		color: var(--accent);
		background: #272930;
		padding: 0.1rem 0.4rem;
		border-radius: 2px;
	}
	.editor-textarea-mock {
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 4px;
		background: #111318;
		padding: 0.4rem;
		font-size: 0.7rem;
		color: var(--text-primary);
		min-height: 55px;
		white-space: pre-wrap;
		line-height: 1.25;
	}
	.editor-actions {
		margin-top: 0.25rem;
		display: flex;
		gap: 0.6rem;
	}
	.btn-mock {
		font-weight: bold;
		cursor: pointer;
		font-size: 0.72rem;
	}

	/* Readme Mock TUI */
	.readme-split-mock {
		display: grid;
		grid-template-columns: 1fr 1.8fr;
		gap: 1rem;
		height: 220px;
	}
	.readme-toc-mock {
		border-right: 1px dashed rgba(255, 255, 255, 0.1);
		padding-right: 0.5rem;
	}
	.readme-body-mock {
		padding-left: 0.5rem;
		overflow-y: auto;
	}
	.readme-text-mock {
		font-size: 0.7rem;
		line-height: 1.35;
		color: var(--text-secondary);
		white-space: pre-wrap;
	}

	.tui-help-bar {
		background: #111318;
		padding: 0.25rem 1rem;
		font-size: 0.75rem;
		color: var(--text-secondary);
		display: flex;
		justify-content: space-between;
		border-top: 1px solid rgba(255, 255, 255, 0.05);
	}

	/* AI Operator workflow section (NEW) */
	.ai-operator-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
	}
	.ai-workflow-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 2rem;
		margin-top: 2rem;
	}
	.ai-workflow-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 12px;
		padding: 2.25rem;
		text-align: center;
		transition: var(--transition);
	}
	.ai-workflow-card:hover {
		border-color: rgba(255,255,255,0.12);
	}
	.w-icon {
		display: inline-block;
		color: var(--accent);
		margin-bottom: 1rem;
	}
	.workflow-step h4 {
		font-size: 1.15rem;
		margin-bottom: 0.75rem;
	}
	.workflow-step p {
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}
	/* Roadmap Section */
	.roadmap-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
		position: relative;
	}
	.roadmap-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 2rem;
		margin-top: 3.5rem;
	}
	.roadmap-card {
		background: rgba(255, 255, 255, 0.01);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		padding: 2rem;
		transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
		position: relative;
		overflow: hidden;
	}
	.roadmap-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		transform: scaleX(0);
		transition: transform 0.5s ease;
	}
	.roadmap-card:hover {
		transform: translateY(-5px);
		border-color: rgba(139, 124, 248, 0.25);
		box-shadow: 
			0 12px 30px rgba(0, 0, 0, 0.4),
			0 0 15px rgba(139, 124, 248, 0.05);
		background: rgba(255, 255, 255, 0.02);
	}
	.roadmap-card:hover::before {
		transform: scaleX(1);
	}
	.roadmap-badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		padding: 0.25rem 0.6rem;
		border-radius: 100px;
		margin-bottom: 1.25rem;
	}
	.roadmap-badge.next {
		background: rgba(139, 124, 248, 0.15);
		color: var(--accent);
		border: 1px solid rgba(139, 124, 248, 0.3);
	}
	.roadmap-badge.future {
		background: rgba(255, 255, 255, 0.05);
		color: var(--text-secondary);
		border: 1px solid rgba(255, 255, 255, 0.1);
	}
	.roadmap-title {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 650;
		color: #fff;
		margin-bottom: 0.75rem;
	}
	.roadmap-desc {
		font-size: 0.85rem;
		line-height: 1.6;
		color: var(--text-secondary);
	}
	/* FAQ Section */
	.faq-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
		background: rgba(10, 11, 14, 0.3);
	}
	.faq-accordion {
		max-width: 800px;
		margin: 3.5rem auto 0 auto;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.faq-item {
		background: rgba(255, 255, 255, 0.01);
		border: 1px solid rgba(255, 255, 255, 0.05);
		border-radius: 8px;
		overflow: hidden;
		transition: all 0.3s ease;
	}
	.faq-item[open] {
		background: rgba(255, 255, 255, 0.02);
		border-color: rgba(139, 124, 248, 0.2);
	}
	.faq-question {
		padding: 1.25rem 1.5rem;
		font-family: var(--font-heading);
		font-size: 1.05rem;
		font-weight: 600;
		color: #fff;
		cursor: pointer;
		display: flex;
		justify-content: space-between;
		align-items: center;
		list-style: none;
		user-select: none;
	}
	.faq-question::-webkit-details-marker {
		display: none;
	}
	.faq-icon {
		font-size: 1.25rem;
		color: var(--text-secondary);
		transition: transform 0.3s ease;
	}
	.faq-item[open] .faq-icon {
		transform: rotate(45deg);
		color: var(--accent);
	}
	.faq-answer {
		padding: 0 1.5rem 1.5rem 1.5rem;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--text-secondary);
	}
	.faq-answer p {
		margin: 0;
	}

	/* Changelog Section */
	.changelog-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
		background: rgba(10, 11, 14, 0.45);
	}
	.changelog-timeline {
		max-width: 800px;
		margin: 3.5rem auto 0 auto;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		position: relative;
	}
	.changelog-timeline::before {
		content: '';
		position: absolute;
		left: 110px;
		top: 10px;
		bottom: 10px;
		width: 2px;
		background: var(--border);
	}
	.changelog-item {
		display: flex;
		gap: 2.5rem;
		position: relative;
	}
	.changelog-meta {
		width: 90px;
		text-align: right;
		flex-shrink: 0;
		padding-top: 0.25rem;
	}
	.version-tag {
		display: block;
		font-family: var(--font-heading);
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--accent);
	}
	.changelog-date {
		display: block;
		font-size: 0.72rem;
		color: var(--text-secondary);
		margin-top: 0.25rem;
	}
	.changelog-content {
		flex-grow: 1;
		background: rgba(255, 255, 255, 0.01);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.5rem 1.75rem;
		position: relative;
	}
	.changelog-content::before {
		content: '';
		position: absolute;
		left: -29px;
		top: 18px;
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: var(--accent);
		border: 2px solid var(--bg);
		z-index: 2;
	}
	.changelog-item-title {
		font-family: var(--font-heading);
		font-size: 1.15rem;
		font-weight: 600;
		color: #fff;
		margin-top: 0;
		margin-bottom: 1rem;
	}
	.changelog-list {
		margin: 0;
		padding-left: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}
	.changelog-list li {
		font-size: 0.9rem;
		line-height: 1.6;
		color: var(--text-secondary);
	}
	.changelog-list li strong {
		color: #fff;
	}
	.changelog-list kbd {
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.15);
		padding: 0.1rem 0.3rem;
		border-radius: 4px;
		font-family: monospace;
		font-size: 0.78rem;
		color: #fff;
	}

	@media (max-width: 640px) {
		.changelog-timeline::before {
			left: 15px;
		}
		.changelog-item {
			flex-direction: column;
			gap: 1rem;
			padding-left: 2.5rem;
		}
		.changelog-meta {
			width: auto;
			text-align: left;
			padding-top: 0;
		}
		.changelog-content::before {
			left: -29px;
			top: -24px;
		}
	}

	/* Pricing Section */
	.pricing-section {
		padding: 6.5rem 0;
		border-top: 1px solid var(--border);
		background: rgba(17, 19, 24, 0.45);
	}
	.pricing-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 2.5rem;
		max-width: 900px;
		margin: 0 auto;
	}
	.pricing-card {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 3rem 2.5rem;
		position: relative;
		display: flex;
		flex-direction: column;
		height: 100%;
		transition: var(--transition);
	}
	.pricing-card:hover {
		border-color: rgba(255,255,255,0.15);
		transform: translateY(-4px);
	}
	.pricing-card.featured {
		border-color: var(--accent);
		background: linear-gradient(180deg, rgba(139, 124, 248, 0.05) 0%, rgba(8, 9, 11, 0) 100%), var(--bg-secondary);
		box-shadow: 0 10px 40px rgba(139, 124, 248, 0.15);
	}
	.pricing-badge {
		position: absolute;
		top: 1.25rem;
		right: 1.5rem;
		background: var(--accent);
		color: var(--bg-primary);
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.25rem 0.75rem;
		border-radius: 100px;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.plan-header {
		margin-bottom: 2rem;
	}
	.plan-name {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.plan-price {
		font-size: 3rem;
		font-weight: 700;
		color: var(--text-primary);
		margin-bottom: 0.5rem;
		display: flex;
		align-items: baseline;
	}
	.price-original {
		font-size: 1.75rem;
		text-decoration: line-through;
		color: var(--text-muted);
		margin-right: 0.5rem;
		font-weight: 500;
	}
	.launch-special-tag {
		font-family: var(--font-mono, monospace);
		font-size: 0.72rem;
		color: var(--success);
		background: rgba(16, 185, 129, 0.08);
		border: 1px solid rgba(16, 185, 129, 0.2);
		padding: 0.25rem 0.5rem;
		border-radius: 4px;
		display: inline-block;
		margin-bottom: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}
	.promo-code-box {
		font-family: var(--font-mono, monospace);
		font-size: 0.75rem;
		background: rgba(139, 124, 248, 0.06);
		border: 1px solid rgba(139, 124, 248, 0.2);
		padding: 0.35rem 0.65rem;
		border-radius: 6px;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		margin-bottom: 1rem;
	}
	.promo-label {
		color: var(--text-secondary);
		text-transform: uppercase;
		font-size: 0.68rem;
		letter-spacing: 0.05em;
	}
	.promo-value {
		color: var(--accent);
		font-weight: 600;
	}
	.price-period {
		font-size: 1rem;
		color: var(--text-secondary);
		font-weight: 400;
		margin-left: 0.25rem;
	}
	.plan-desc {
		color: var(--text-secondary);
		font-size: 0.95rem;
	}
	.plan-features {
		list-style: none;
		margin-bottom: 2.5rem;
	}
	.plan-cta {
		margin-top: auto;
	}
	.plan-features li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		margin-bottom: 0.85rem;
		font-size: 0.9rem;
		color: var(--text-secondary);
		line-height: 1.5;
	}
	.check-icon {
		color: var(--success);
		font-weight: bold;
		flex-shrink: 0;
		margin-top: 0.15rem;
	}
	
	/* Donate Banner */
	.donate-banner {
		background: var(--bg-secondary);
		border: 1px solid var(--border);
		border-radius: 16px;
		padding: 2.5rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 4.5rem;
		flex-wrap: wrap;
		gap: 2rem;
	}
	@media (max-width: 768px) {
		.donate-banner {
			flex-direction: column;
			text-align: center;
		}
	}
	.donate-content h3 {
		font-size: 1.5rem;
		margin-bottom: 0.5rem;
	}
	.donate-content p {
		color: var(--text-secondary);
	}

	/* Footer Styling */
	.footer {
		padding: 4rem 0;
		border-top: 1px solid var(--border);
		background: var(--bg-primary);
		color: var(--text-secondary);
		font-size: 0.85rem;
	}
	.footer-container {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1.5rem;
	}
	@media (max-width: 640px) {
		.footer-container {
			flex-direction: column;
			text-align: center;
		}
	}
	.footer-left {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.1rem;
		color: var(--text-primary);
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	.footer-right {
		display: flex;
		gap: 2rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.footer-link:hover {
		color: var(--text-primary);
	}

	/* Back to Top Button */
	.back-to-top {
		position: fixed;
		bottom: 2rem;
		right: 2rem;
		z-index: 99;
		background: rgba(13, 14, 18, 0.8);
		backdrop-filter: blur(8px);
		border: 1px solid var(--border);
		color: var(--text-secondary);
		width: 44px;
		height: 44px;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transform: translateY(10px);
		transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
		box-shadow: var(--shadow-md);
	}
	.back-to-top.visible {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.back-to-top:hover {
		color: var(--accent);
		border-color: var(--accent);
		box-shadow: 0 0 15px var(--accent-glow);
		transform: translateY(-2px);
	}

	/* Scroll Reveal Animations */
	.reveal {
		opacity: 0;
		transform: translateY(36px);
		transition: opacity 0.75s cubic-bezier(0.16, 1, 0.3, 1), transform 0.75s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}
	.reveal-delay-1 { transition-delay: 0.1s; }
	.reveal-delay-2 { transition-delay: 0.2s; }
	.reveal-delay-3 { transition-delay: 0.3s; }

	/* Page transition */
	@keyframes page-fade-in {
		from { opacity: 0; transform: translateY(12px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	main {
		animation: page-fade-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	/* Screenshot section improvements */

	/* ── TUI Demo ──────────────────────────────────────────── */
	.tui-demo-section {
		padding: 5rem 0 6rem;
	}
	.tui-window {
		width: 100%;
		max-width: 900px;
		margin: 0 auto;
		background: #1a202c; /* ColorBg from styles.go */
		border: 1px solid #2d3748; /* ColorDarkGray from styles.go */
		border-radius: 10px;
		overflow: hidden;
		box-shadow: 0 0 0 1px rgba(255,255,255,0.04), 0 32px 80px rgba(0,0,0,0.7), 0 0 60px rgba(139,124,248,0.06);
		outline: none;
		transition: box-shadow 0.2s ease;
	}
	.tui-window:focus {
		box-shadow: 0 0 0 2px rgba(139,124,248,0.4), 0 32px 80px rgba(0,0,0,0.7), 0 0 60px rgba(139,124,248,0.12);
	}

	/* Window top bar (Mac style dots) */
	.tui-chrome {
		background: #0d0e14;
		border-bottom: 1px solid rgba(255,255,255,0.07);
		display: grid;
		grid-template-columns: auto 1fr auto;
		align-items: center;
		padding: 0.6rem 1rem;
		gap: 1rem;
	}
	.tui-dots { display: flex; gap: 0.4rem; align-items: center; }
	.tui-dot { width: 12px; height: 12px; border-radius: 50%; }
	.tui-dot-red    { background: #ff5f57; }
	.tui-dot-yellow { background: #ffbd2e; }
	.tui-dot-green  { background: #28c840; }
	.tui-chrome-title {
		text-align: center;
		color: rgba(255,255,255,0.4);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		letter-spacing: 0.04em;
	}

	/* Terminal Inner content wrapper */
	.tui-window-content {
		padding: 1.5rem;
		background: #1a202c; /* ColorBg */
	}

	/* Title Block */
	.tui-title-block {
		background: #8b7cf8; /* ColorPrimary */
		color: #1a202c; /* ColorBg */
		font-weight: bold;
		padding: 0.1rem 0.5rem;
		display: inline-block;
		margin-bottom: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}

	/* Tab bar (mimics tabs.go horizontal layout) */
	.tui-tabbar {
		display: flex;
		background: #1a202c;
		border-bottom: 2px solid #8b7cf8; /* ColorPrimary line */
		padding: 0;
		gap: 2px;
		margin-bottom: 1.5rem;
	}
	.tui-tab-btn {
		background: #1a202c;
		border: 1px solid #2d3748; /* ColorDarkGray */
		border-bottom: none;
		color: #718096; /* ColorLightGray */
		font-family: var(--font-mono);
		font-size: 0.8rem;
		font-weight: bold;
		padding: 0.45rem 1rem;
		cursor: pointer;
		border-radius: 4px 4px 0 0;
		display: flex;
		align-items: center;
		gap: 0.4rem;
		position: relative;
		bottom: -2px; /* overlap with tabbar border-bottom */
		z-index: 1;
		transition: color 0.15s ease;
	}
	.tui-tab-btn:hover { color: #cbd5e0; }
	.tui-tab-btn.active {
		color: #00f5d4; /* ColorSecondary */
		border-color: #8b7cf8; /* ColorPrimary */
		border-bottom: 2px solid #1a202c; /* hide tabbar bottom line */
		z-index: 2;
	}

	/* Panel body */
	.tui-body {
		min-height: 280px;
		background: #1a202c;
		color: #ecc94b; /* Default terminal text: Yellow */
		font-family: var(--font-mono);
		font-size: 0.85rem;
	}
	.tui-panel { display: none; }
	.tui-panel.active { display: block; }

	/* Layout elements */
	.tui-dashboard-layout {
		display: grid;
		grid-template-columns: 43fr 35fr;
		gap: 1.5rem;
		align-items: start;
	}
	@media (max-width: 768px) {
		.tui-dashboard-layout {
			grid-template-columns: 1fr;
			gap: 1rem;
		}
	}

	/* Lipgloss StyleBox simulation */
	.tui-box {
		border: 1px solid #2d3748; /* ColorDarkGray */
		border-radius: 8px; /* RoundedBorder */
		padding: 1rem 1.25rem;
		background: transparent;
		box-sizing: border-box;
	}

	/* Headers inside boxes */
	.tui-label {
		color: #8b7cf8; /* ColorPrimary */
		font-weight: bold;
		font-size: 0.82rem;
		letter-spacing: 0.05em;
		margin-bottom: 0.75rem;
	}

	/* Text styles */
	.tui-muted  { color: #718096; } /* ColorLightGray */
	.tui-val    { color: #ecc94b; } /* Default is same as text, but explicitly yellow */
	.tui-ok     { color: #48bb78; } /* ColorPosted */
	.tui-warn   { color: #ecc94b; } /* ColorScheduled */
	.tui-error  { color: #f56565; } /* ColorFailed */
	.tui-connected { color: #48bb78; font-weight: bold; }
	.tui-gap    { height: 1rem; }

	/* Cursor arrows */
	.tui-arr    { color: #00f5d4; font-weight: bold; margin-right: 0.5rem; display: inline-block; }
	.tui-arr-h  { opacity: 0; }

	/* Campaigns tab styling */
	.tui-campaign-item {
		display: flex;
		align-items: center;
		padding: 0.1rem 0;
	}
	.tui-rtitle { color: #ecc94b; }
	.tui-meta   { color: #ecc94b; font-size: 0.82rem; margin-bottom: 0.4rem; }

	/* Stats rows */
	.tui-stat-r {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.2rem;
		color: #ecc94b;
	}

	/* Platform list rows */
	.tui-plat-r {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.2rem;
		color: #ecc94b;
	}

	/* Posts list */
	.tui-post-item {
		margin-bottom: 0.9rem;
	}
	.tui-post-header-line {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: #ecc94b;
	}
	.tui-post-meta-plat {
		font-weight: bold;
	}
	.tui-post-badge {
		font-size: 0.72rem;
		font-weight: bold;
		padding: 0 0.4rem;
		border-radius: 2px;
	}
	.badge-posted {
		background: #48bb78;
		color: #1a202c;
	}
	.badge-scheduled {
		background: #ecc94b;
		color: #1a202c;
	}
	.badge-draft {
		background: #a0aec0;
		color: #1a202c;
	}
	.badge-failed {
		background: #f56565;
		color: #f7fafc;
	}
	.tui-post-body {
		color: #cbd5e0;
		margin-left: 2ch;
		padding-left: 1.2rem;
		margin-top: 0.15rem;
		font-weight: bold;
	}
	.tui-post-meta-line {
		color: #718096;
		margin-left: 2ch;
		padding-left: 1.2rem;
		margin-top: 0.1rem;
		font-size: 0.78rem;
	}
	/* Selected post item */
	.tui-post-item.tui-row-sel .tui-post-body {
		color: #00f5d4 !important;
	}

	/* Schedule tab */
	.tui-sch-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.15rem 0;
	}
	.tui-sch-icon {
		color: #8b7cf8;
	}
	.tui-sch-time {
		min-width: 150px;
		color: #ecc94b;
	}
	.tui-sch-plat {
		min-width: 90px;
		font-weight: bold;
		color: #ecc94b;
	}
	.tui-sch-lang {
		min-width: 30px;
		color: #ecc94b;
	}
	.tui-sch-title {
		color: #ecc94b;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	/* Selected schedule item */
	.tui-sch-item.tui-row-sel .tui-sch-plat {
		color: #00f5d4 !important;
	}

	/* History tab */
	.tui-hist-row {
		display: flex;
		align-items: center;
		gap: 1.2rem;
		padding: 0.2rem 0;
	}
	.tui-hist-time {
		color: #ecc94b;
		min-width: 170px;
	}
	.tui-hist-action {
		min-width: 70px;
		font-weight: bold;
	}
	.tui-hist-action.tui-ok {
		color: #48bb78;
	}
	.tui-hist-action.tui-error {
		color: #f56565;
	}
	.tui-hist-info {
		color: #718096;
	}
	/* Selected history item */
	.tui-hist-row.tui-row-sel .tui-hist-info {
		color: #00f5d4 !important;
	}

	/* Settings tab */
	.tui-set-row {
		display: flex;
		align-items: center;
		padding: 0.15rem 0;
		color: #ecc94b;
		font-family: var(--font-mono);
	}
	.tui-skey {
		white-space: pre;
	}
	.tui-sval {
		margin-left: 0.5rem;
		font-weight: bold;
	}
	.val-cyan {
		color: #00f5d4;
	}
	.val-red {
		color: #f56565;
	}
	.val-green {
		color: #48bb78;
	}
	.val-gray {
		color: #718096;
	}
	/* Selected setting row */
	.tui-set-row.tui-row-sel .tui-skey {
		color: #00f5d4 !important;
		font-weight: bold;
	}
	.tui-set-row.tui-row-sel .tui-sval.val-cyan {
		color: #00f5d4 !important;
	}

	/* Help / status footers */
	.tui-statusbar {
		color: #718096;
		font-style: italic;
		font-size: 0.78rem;
		padding-top: 0.5rem;
		font-family: var(--font-mono);
	}
	/* Kbd hints */
	.kbd {
		display: inline-block;
		background: rgba(255,255,255,0.08);
		border: 1px solid rgba(255,255,255,0.15);
		border-radius: 4px;
		padding: 0.1rem 0.35rem;
		font-family: var(--font-mono);
		font-size: 0.78em;
		color: rgba(255,255,255,0.7);
	}
	.tui-demo-hint {
		text-align: center;
		margin-top: 1rem;
